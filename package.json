{
  "name": "ecs",
  "version": "0.1.0",
  "private": true,
  "description": "ECS - economic consulting internship scanner (sister project of QJS)",
  "type": "module",
  "scripts": {
    "scan:v1": "node ./scripts/run-econ-scan.mjs --mode=v1",
    "scan:v2": "node ./scripts/run-econ-scan.mjs --mode=v2",
    "scan:v2:publish": "node ./scripts/run-econ-scan.mjs --mode=v2 --publish",
    "scan:all": "node ./scripts/run-econ-scan.mjs --mode=all",
    "scan:all:publish": "node ./scripts/run-econ-scan.mjs --mode=all --publish",
    "publish": "node ./scripts/publish_scan_results.mjs",
    "report:new": "node ./scripts/report-new-roles.mjs",
    "readme": "node ./scripts/build-readme.mjs",
    "test": "node ./tools/selftest.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
